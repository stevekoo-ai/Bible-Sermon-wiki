<Placemark><name>49 → 예루살렘 → 아나돗</name><description>갇힌 채 아나돗의 밭을 삼 — '다시 사게 되리라'</description><styleUrl>#lC78BE8</styleUrl><MultiGeometry><LineString><tessellate>1</tessellate><coordinates>35.23540,31.77810,0 35.23723,31.77952,0 35.23901,31.78097,0 35.24076,31.78246,0 35.24246,31.78398,0 35.24412,31.78554,0 35.24574,31.78713,0 35.24732,31.78875,0 35.24885,31.79041,0 35.25034,31.79211,0 35.25179,31.79383,0 35.25320,31.79560,0 35.25457,31.79739,0 35.25590,31.79922,0 35.25718,31.80109,0 35.25842,31.80299,0 35.25962,31.80492,0 35.26078,31.80689,0 35.26189,31.80889,0 35.26297,31.81093,0 35.26400,31.81300,0</coordinates></LineString><Polygon><outerBoundaryIs><LinearRing><coordinates>35.26400,31.81300,0 35.24557,31.80056,0 35.26583,31.79306,0 35.26400,31.81300,0</coordinates></LinearRing></outerBoundaryIs></Polygon></MultiGeometry></Placemark>
