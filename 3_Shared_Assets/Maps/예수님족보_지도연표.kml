<Placemark><name>6 → 단 → 예루살렘</name><description>멜기세덱 — 살렘 왕, 지극히 높은 하나님의 제사장</description><styleUrl>#lC78BE8</styleUrl><MultiGeometry><LineString><tessellate>1</tessellate><coordinates>35.65250,33.24860,0 35.64841,33.17032,0 35.64255,33.09254,0 35.63493,33.01526,0 35.62555,32.93848,0 35.61440,32.86221,0 35.60148,32.78643,0 35.58680,32.71115,0 35.57036,32.63638,0 35.55215,32.56210,0 35.53218,32.48832,0 35.51044,32.41505,0 35.48694,32.34228,0 35.46167,32.27000,0 35.43464,32.19823,0 35.40585,32.12696,0 35.37529,32.05618,0 35.34296,31.98591,0 35.30887,31.91614,0 35.27302,31.84687,0 35.23540,31.77810,0</coordinates></LineString><Polygon><outerBoundaryIs><LinearRing><coordinates>35.23540,31.77810,0 35.26387,31.79678,0 35.23311,31.80861,0 35.23540,31.77810,0</coordinates></LinearRing></outerBoundaryIs></Polygon></MultiGeometry></Placemark>
