<Placemark><name>16 → 립나 → 바벨론</name><description>시드기야, 바벨론 감옥에서 죽을 때까지</description><styleUrl>#lFF4D4D</styleUrl><MultiGeometry><LineString><tessellate>1</tessellate><coordinates>36.38000,34.48000,0 36.75989,34.29115,0 37.14211,34.11196,0 37.52666,33.94241,0 37.91355,33.78251,0 38.30276,33.63226,0 38.69431,33.49166,0 39.08819,33.36071,0 39.48441,33.23940,0 39.88296,33.12775,0 40.28383,33.02575,0 40.68705,32.93339,0 41.09259,32.85068,0 41.50046,32.77763,0 41.91067,32.71422,0 42.32321,32.66046,0 42.73809,32.61635,0 43.15529,32.58189,0 43.57483,32.55708,0 43.99670,32.54191,0 44.42090,32.53640,0</coordinates></LineString><Polygon><outerBoundaryIs><LinearRing><coordinates>44.42090,32.53640,0 44.35906,32.56609,0 44.35712,32.50978,0 44.42090,32.53640,0</coordinates></LinearRing></outerBoundaryIs></Polygon></MultiGeometry></Placemark>
