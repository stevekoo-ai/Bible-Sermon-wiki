<Placemark><name>15 → 아라바 길(광야) → 여리고</name><description>여리고 평지에서 시드기야 생포</description><styleUrl>#lFF4D4D</styleUrl><MultiGeometry><LineString><tessellate>1</tessellate><coordinates>35.34000,31.81000,0 35.34590,31.81187,0 35.35172,31.81386,0 35.35747,31.81598,0 35.36315,31.81823,0 35.36875,31.82060,0 35.37428,31.82309,0 35.37974,31.82571,0 35.38512,31.82845,0 35.39043,31.83132,0 35.39567,31.83431,0 35.40083,31.83743,0 35.40592,31.84067,0 35.41094,31.84404,0 35.41588,31.84753,0 35.42075,31.85115,0 35.42555,31.85489,0 35.43027,31.85875,0 35.43492,31.86274,0 35.43950,31.86686,0 35.44400,31.87110,0</coordinates></LineString><Polygon><outerBoundaryIs><LinearRing><coordinates>35.44400,31.87110,0 35.43066,31.86713,0 35.44041,31.85949,0 35.44400,31.87110,0</coordinates></LinearRing></outerBoundaryIs></Polygon></MultiGeometry></Placemark>
