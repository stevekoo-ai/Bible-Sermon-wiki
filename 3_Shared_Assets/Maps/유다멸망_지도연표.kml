<Placemark><name>6 → 바벨론 → 마리(유프라테스) → 갈그미스 → 하맛 → 립나 → 하솔 → 예루살렘</name><description>여호야김 사망, 여호야긴 즉위</description><styleUrl>#l4FA3E0</styleUrl><MultiGeometry><LineString><tessellate>1</tessellate><coordinates>44.42090,32.53640,0 44.22136,32.59677,0 44.02424,32.66137,0 43.82953,32.73021,0 43.63724,32.80330,0 43.44736,32.88061,0 43.25989,32.96217,0 43.07485,33.04797,0 42.89221,33.13800,0 42.71200,33.23228,0 42.53419,33.33079,0 42.35881,33.43354,0 42.18583,33.54052,0 42.01528,33.65175,0 41.84713,33.76721,0 41.68141,33.88691,0 41.51810,34.01086,0 41.35720,34.13903,0 41.19872,34.27145,0 41.04265,34.40811,0 40.88900,34.54900,0 40.71927,34.63026,0 40.55228,34.71497,0 40.38802,34.80313,0 40.22650,34.89474,0 40.06772,34.98979,0 39.91168,35.08830,0 39.75837,35.19026,0 39.60780,35.29566,0 39.45996,35.40452,0 39.31486,35.51682,0 39.17250,35.63258,0 39.03288,35.75178,0 38.89599,35.87444,0 38.76184,36.00054,0 38.63042,36.13009,0 38.50174,36.26310,0 38.37580,36.39955,0 38.25260,36.53945,0 38.13213,36.68280,0 38.01440,36.82960,0 37.97089,36.73034,0 37.92535,36.63258,0 37.87777,36.53633,0 37.82815,36.44160,0 37.77649,36.34837,0 37.72279,36.25665,0 37.66705,36.16644,0 37.60928,36.07773,0 37.54947,35.99054,0 37.48762,35.90486,0 37.42373,35.82068,0 37.35780,35.73801,0 37.28983,35.65686,0 37.21983,35.57721,0 37.14779,35.49907,0 37.07371,35.42244,0 36.99759,35.34731,0 36.91943,35.27370,0 36.83923,35.20160,0 36.75700,35.13100,0 36.74557,35.09415,0 36.73336,35.05776,0 36.72037,35.02181,0 36.70660,34.98632,0 36.69205,34.95128,0 36.67671,34.91670,0 36.66059,34.88257,0 36.64370,34.84888,0 36.62602,34.81566,0 36.60756,34.78288,0 36.58832,34.75056,0 36.56830,34.71868,0 36.54749,34.68727,0 36.52591,34.65630,0 36.50355,34.62579,0 36.48040,34.59572,0 36.45647,34.56611,0 36.43176,34.53696,0 36.40627,34.50825,0 36.38000,34.48000,0 36.35608,34.39759,0 36.33040,34.31616,0 36.30297,34.23570,0 36.27378,34.15622,0 36.24283,34.07771,0 36.21014,34.00018,0 36.17568,33.92361,0 36.13947,33.84803,0 36.10150,3