<Placemark><name>72 → 나사렛 → 베들레헴</name><description>요셉과 마리아, 베들레헴으로 — 예수 탄생</description><styleUrl>#l5CC98A</styleUrl><MultiGeometry><LineString><tessellate>1</tessellate><coordinates>35.30350,32.69960,0 35.28711,32.65104,0 35.27192,32.60236,0 35.25791,32.55356,0 35.24510,32.50464,0 35.23349,32.45560,0 35.22306,32.40644,0 35.21383,32.35715,0 35.20579,32.30774,0 35.19895,32.25822,0 35.19330,32.20857,0 35.18884,32.15880,0 35.18557,32.10890,0 35.18350,32.05889,0 35.18262,32.00876,0 35.18294,31.95850,0 35.18444,31.90812,0 35.18714,31.85762,0 35.19104,31.80700,0 35.19612,31.75626,0 35.20240,31.70540,0</coordinates></LineString><Polygon><outerBoundaryIs><LinearRing><coordinates>35.20240,31.70540,0 35.21142,31.72387,0 35.18945,31.72209,0 35.20240,31.70540,0</coordinates></LinearRing></outerBoundaryIs></Polygon></MultiGeometry></Placemark>
